{
  "manifest_version": 3,
  "name": "Control PC - YouTube Music",
  "version": "1.0",
  "description": "Permite controlar YouTube Music de este navegador desde la app Control PC del celular (solo red local).",
  "minimum_chrome_version": "111",
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "scripting", "alarms"],
  "host_permissions": ["https://music.youtube.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "128": "icon128.png" }
}
